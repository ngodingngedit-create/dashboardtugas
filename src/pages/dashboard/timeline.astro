---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createAstroSupabaseClient } from '../../lib/supabase';
import {
  diffDaysJakarta,
  formatJakartaDate,
  getJakartaCurrentYearMonth,
  toJakartaYMD,
} from '../../lib/jakarta-time';
import type { Workspace } from '../../types/database';

const supabase = createAstroSupabaseClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user?.id)
  .single();

const { data: memberWorkspaces } = await supabase
  .from('workspace_members')
  .select('workspace:workspaces (*)')
  .eq('user_id', user?.id);
const workspaces: Workspace[] = (memberWorkspaces || [])
  .map((m: any) => m.workspace)
  .filter(Boolean);
const workspaceIds = workspaces.map((w) => w.id);

// --- Bulan aktif: default mengikuti tanggal saat ini di Asia/Jakarta (WIB) ---
const monthParam = Astro.url.searchParams.get('month');
const currentJkt = getJakartaCurrentYearMonth();
let year = currentJkt.year;
let month = currentJkt.month - 1; // 0-based
if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split('-').map(Number);
  if (m >= 1 && m <= 12) {
    year = y;
    month = m - 1;
  }
}
const monthStr = `${year}-${String(month + 1).padStart(2, '0')}`;
const prev = new Date(Date.UTC(year, month - 1, 1));
const next = new Date(Date.UTC(year, month + 1, 1));
const prevStr = `${prev.getUTCFullYear()}-${String(prev.getUTCMonth() + 1).padStart(2, '0')}`;
const nextStr = `${next.getUTCFullYear()}-${String(next.getUTCMonth() + 1).padStart(2, '0')}`;
const monthLabel = formatJakartaDate(new Date(Date.UTC(year, month, 1)), { month: 'long', year: 'numeric' });

// --- Fetch tugas dengan deadline pada rentang bulan ini (± buffer beberapa minggu) ---
interface CalTask {
  id: string;
  title: string;
  status: string;
  due_date: string;
  workspace?: { name: string } | null;
}
let tasks: CalTask[] = [];
if (workspaceIds.length > 0) {
  // Rentang query longgar (UTC) agar mencakup batas tanggal WIB
  const rangeStart = new Date(Date.UTC(year, month - 1, 1)).toISOString();
  const rangeEnd = new Date(Date.UTC(year, month + 2, 1)).toISOString();
  const { data } = await supabase
    .from('tasks')
    .select('id, title, status, due_date, workspace:workspaces (name)')
    .in('workspace_id', workspaceIds)
    .not('due_date', 'is', null)
    .gte('due_date', rangeStart)
    .lt('due_date', rangeEnd)
    .order('due_date', { ascending: true });
  tasks = (data || []) as unknown as CalTask[];
}

// Kelompokkan per tanggal kalender Asia/Jakarta (YYYY-MM-DD)
const tasksByDay = new Map<string, CalTask[]>();
for (const t of tasks) {
  const key = toJakartaYMD(t.due_date);
  if (!key) continue;
  if (!tasksByDay.has(key)) tasksByDay.set(key, []);
  tasksByDay.get(key)!.push(t);
}

// --- Bangun grid kalender (minggu mulai Senin, murni tanggal kalender) ---
interface DayCell {
  key: string;       // YYYY-MM-DD
  dayNumber: number; // 1-31
  inMonth: boolean;
}
// Hari pertama bulan aktif: cari hari dalam minggu (0=Min..6=Sab)
const firstDayUtc = new Date(Date.UTC(year, month, 1));
const startOffset = (firstDayUtc.getUTCDay() + 6) % 7; // Senin-first
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const totalCells = Math.ceil((startOffset + daysInMonth) / 7) * 7;

const cells: DayCell[] = [];
for (let i = 0; i < totalCells; i++) {
  const cellDate = new Date(Date.UTC(year, month, 1 - startOffset + i));
  const cY = cellDate.getUTCFullYear();
  const cM = cellDate.getUTCMonth();
  const cD = cellDate.getUTCDate();
  const key = `${cY}-${String(cM + 1).padStart(2, '0')}-${String(cD).padStart(2, '0')}`;
  cells.push({
    key,
    dayNumber: cD,
    inMonth: cY === year && cM === month,
  });
}

const todayKey = toJakartaYMD(new Date());

// Warna chip per tugas: selisih hari dihitung berbasis tanggal Jakarta (WIB)
function chipClass(t: CalTask): string {
  if (t.status === 'done') return 'border-emerald-400 bg-emerald-50 text-emerald-700 hover:bg-emerald-100';
  const diff = diffDaysJakarta(t.due_date);
  if (diff !== null && diff < 0) return 'border-rose-400 bg-rose-50 text-rose-700 hover:bg-rose-100';
  if (diff === 0) return 'border-amber-400 bg-amber-50 text-amber-800 hover:bg-amber-100';
  return 'border-blue-400 bg-blue-50 text-blue-700 hover:bg-blue-100';
}
function dotClass(t: CalTask): string {
  if (t.status === 'done') return 'bg-emerald-500';
  const diff = diffDaysJakarta(t.due_date);
  if (diff !== null && diff < 0) return 'bg-rose-500';
  if (diff === 0) return 'bg-amber-500';
  return 'bg-blue-500';
}

// Ringkasan bulan aktif (berbasis tanggal Jakarta)
const monthPrefix = `${year}-${String(month + 1).padStart(2, '0')}-`;
const monthTasks = tasks.filter((t) => toJakartaYMD(t.due_date).startsWith(monthPrefix));
const monthDone = monthTasks.filter((t) => t.status === 'done').length;
const monthOverdue = monthTasks.filter((t) => {
  if (t.status === 'done') return false;
  const diff = diffDaysJakarta(t.due_date);
  return diff !== null && diff < 0;
}).length;

const weekDays = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
const weekDaysFull = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
const MAX_CHIPS = 2;
---

<DashboardLayout
  title="Timeline - TaskPilot"
  headerTitle="Timeline Deadline"
  user={user}
  profile={profile}
  workspaces={workspaces}
  currentWorkspace={null}
>
  <div class="max-w-6xl mx-auto space-y-4 sm:space-y-5">
    <!-- Header kalender + Indikator Jam 24 Jam Jakarta -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-lg sm:text-xl font-bold text-slate-800 capitalize">{monthLabel}</h2>
          <!-- Visual badge zona waktu Asia/Jakarta + jam live -->
          <span
            id="jakarta-clock-badge"
            title="Waktu server disinkronkan ke zona Asia/Jakarta (24 jam WIB)"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200/70 text-emerald-700 text-[11px] font-semibold"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>WIB (UTC+7)</span>
            <span class="text-emerald-400">•</span>
            <span id="jakarta-live-clock" class="font-mono font-bold tracking-tight">--:--:--</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">
          {monthTasks.length} deadline bulan ini
          {monthOverdue > 0 && <span class="text-rose-500 font-semibold"> • {monthOverdue} terlewat</span>}
          {monthDone > 0 && <span class="text-emerald-600 font-semibold"> • {monthDone} selesai</span>}
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href={`/dashboard/timeline?month=${prevStr}`} class="px-3 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 text-sm font-semibold hover:bg-slate-50 transition" aria-label="Bulan sebelumnya">‹</a>
        <a href="/dashboard/timeline" class="px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-700 text-xs font-bold hover:bg-slate-50 transition">Hari Ini</a>
        <a href={`/dashboard/timeline?month=${nextStr}`} class="px-3 py-2 rounded-xl border border-slate-200 bg-white text-slate-600 text-sm font-semibold hover:bg-slate-50 transition" aria-label="Bulan berikutnya">›</a>
      </div>
    </div>

    {workspaces.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 px-5 sm:px-8">
        <div class="text-4xl mb-4">🚀</div>
        <h3 class="text-base sm:text-lg font-bold text-slate-800">Belum Ada Workspace</h3>
        <p class="text-xs text-slate-400 mt-2 mb-6">Buat workspace terlebih dahulu untuk mulai melihat timeline deadline.</p>
        <a href="/dashboard/workspaces" class="inline-block px-5 py-2.5 bg-indigo-600 text-white font-bold text-xs rounded-xl hover:bg-indigo-700 transition">Buat Workspace Sekarang</a>
      </div>
    ) : (
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        <!-- Header hari -->
        <div class="grid grid-cols-7 border-b border-slate-200 bg-slate-50/60">
          {weekDays.map((d, i) => (
            <div class="py-2.5 text-center text-[10px] sm:text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <span class="sm:hidden">{d}</span>
              <span class="hidden sm:inline">{weekDaysFull[i]}</span>
            </div>
          ))}
        </div>

        <!-- Grid tanggal: garis sejajar via divide, tinggi sel tetap -->
        <div class="grid grid-cols-7 divide-x divide-y divide-slate-100">
          {cells.map((cell) => {
            const dayTasks = tasksByDay.get(cell.key) || [];
            const isToday = cell.key === todayKey;
            return (
              <div class={`min-w-0 h-20 sm:h-28 flex flex-col overflow-hidden px-1 pt-1 sm:px-1.5 sm:pt-1.5 ${cell.inMonth ? 'bg-white' : 'bg-slate-50/60'}`}>
                <div class="flex items-center justify-between">
                  <span class={`inline-flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 shrink-0 text-[10px] sm:text-xs font-semibold rounded-full ${isToday ? 'bg-indigo-600 text-white shadow-xs' : cell.inMonth ? 'text-slate-700' : 'text-slate-300'}`}>
                    {cell.dayNumber}
                  </span>
                  {isToday && (
                    <span class="hidden md:inline-block text-[9px] font-bold text-indigo-600 uppercase tracking-wider px-1">
                      Hari ini
                    </span>
                  )}
                </div>

                <!-- Chip tugas (desktop) -->
                <div class="hidden sm:flex flex-col gap-1 mt-1 min-h-0 overflow-hidden">
                  {dayTasks.slice(0, MAX_CHIPS).map((t) => (
                    <a
                      href={`/dashboard/task/${t.id}`}
                      title={`${t.title} • ${t.workspace?.name || 'Workspace'}`}
                      class={`block truncate rounded-md border-l-2 px-1.5 py-0.5 text-[10px] leading-4 font-semibold transition ${chipClass(t)} ${cell.inMonth ? '' : 'opacity-60'}`}
                    >
                      {t.title}
                    </a>
                  ))}
                  {dayTasks.length > MAX_CHIPS && (
                    <p class="text-[9px] leading-3 font-semibold text-slate-400 px-1">+{dayTasks.length - MAX_CHIPS} lagi</p>
                  )}
                </div>

                <!-- Indikator titik (mobile) -->
                <div class="flex sm:hidden flex-1 flex-wrap content-end items-end gap-1 pb-1">
                  {dayTasks.slice(0, 3).map((t) => (
                    <a href={`/dashboard/task/${t.id}`} class={`w-1.5 h-1.5 shrink-0 rounded-full ${dotClass(t)}`} aria-label={t.title}></a>
                  ))}
                  {dayTasks.length > 3 && (
                    <span class="text-[8px] leading-none font-bold text-slate-400">+{dayTasks.length - 3}</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Legenda + Info Zona Waktu -->
    <div class="flex flex-wrap items-center justify-between gap-y-2 text-[11px] font-semibold text-slate-500 pt-1">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
        <span class="text-slate-400 uppercase tracking-wider text-[10px] font-bold">Legenda:</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Terlewat</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Hari ini</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Akan datang</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Selesai</span>
      </div>
      <span class="text-[10px] text-slate-400 font-medium">
        Zona Waktu: <strong class="text-slate-600 font-semibold">Asia/Jakarta (WIB • GMT+7)</strong> format 24 jam
      </span>
    </div>
  </div>

  <!-- Script Jam Digital Live 24 Jam Asia/Jakarta di klien -->
  <script>
    const clockEl = document.getElementById('jakarta-live-clock');
    if (clockEl) {
      const updateClock = () => {
        try {
          const formatter = new Intl.DateTimeFormat('id-ID', {
            timeZone: 'Asia/Jakarta',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
          clockEl.textContent = formatter.format(new Date());
        } catch {
          clockEl.textContent = '--:--:--';
        }
      };
      updateClock();
      setInterval(updateClock, 1000);
    }
  </script>
</DashboardLayout>
