---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createAstroSupabaseClient } from '../../lib/supabase';
import type { Workspace } from '../../types/database';

const supabase = createAstroSupabaseClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user?.id)
  .single();

const { data: memberWorkspaces } = await supabase
  .from('workspace_members')
  .select(`
    role,
    workspace:workspaces (
      *,
      members:workspace_members (
        id,
        role,
        profile:profiles (*)
      )
    )
  `)
  .eq('user_id', user?.id);

const workspaces: Workspace[] = (memberWorkspaces || [])
  .map((m: any) => m.workspace)
  .filter(Boolean);
---

<DashboardLayout 
  title="Kelola Workspace - TaskPilot" 
  user={user} 
  profile={profile} 
  workspaces={workspaces}
  currentWorkspace={workspaces[0] || null}
>
  <div class="max-w-4xl mx-auto space-y-6 sm:space-y-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <h2 class="text-lg sm:text-xl font-bold text-slate-800">Daftar Workspace</h2>
        <p class="text-xs text-slate-400 mt-1">Kelola ruang kerja atau proyek kolaborasi tim Anda.</p>
      </div>
      <button 
        id="open-ws-modal"
        class="w-full sm:w-auto shrink-0 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer"
      >
        + Buat Workspace Baru
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 lg:gap-6">
      {memberWorkspaces?.map((item: any) => {
        const canInvite = item.role === 'owner' || item.role === 'admin';
        const memberCount = item.workspace.members?.length || 1;
        return (
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col justify-between min-w-0">
            <div class="min-w-0">
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="font-bold text-base text-slate-800 truncate min-w-0 flex-1">{item.workspace.name}</h3>
                <span class="shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-600">
                  {item.role}
                </span>
              </div>
              <p class="text-xs text-slate-500 line-clamp-2 mb-4">
                {item.workspace.description || 'Tidak ada deskripsi'}
              </p>

              <!-- Member Avatars -->
              <div class="flex items-center justify-between py-2 border-t border-slate-100">
                <span class="text-xs text-slate-400 font-medium">Anggota ({memberCount})</span>
                <div class="flex -space-x-1.5 overflow-hidden">
                  {item.workspace.members?.slice(0, 5).map((m: any) => (
                    <div 
                      title={`${m.profile?.full_name || 'Member'} (${m.role})`}
                      class="w-6 h-6 rounded-full bg-slate-200 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-600 overflow-hidden"
                    >
                      {m.profile?.avatar_url ? (
                        <img src={m.profile.avatar_url} class="w-full h-full object-cover" />
                      ) : (
                        m.profile?.full_name?.charAt(0).toUpperCase() || 'U'
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
              {canInvite ? (
                <button
                  class="invite-team-btn text-xs font-semibold text-slate-600 hover:text-indigo-600 transition flex items-center gap-1.5 cursor-pointer"
                  data-workspace-id={item.workspace.id}
                  data-workspace-name={item.workspace.name}
                >
                  <span>🔗</span> Salin Link Undangan
                </button>
              ) : (
                <span></span>
              )}
              <a 
                href={`/dashboard?workspace_id=${item.workspace.id}`}
                class="text-xs font-semibold text-indigo-600 hover:text-indigo-700"
              >
                Buka Board &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Modal Workspace Baru -->
  <div id="ws-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 max-h-[92dvh] overflow-y-auto">
      <h3 class="text-base font-bold text-slate-800 mb-4">Buat Workspace Baru</h3>
      <form id="create-ws-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Workspace</label>
          <input 
            type="text" 
            name="name" 
            required 
            placeholder="Contoh: Tim Engineering" 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Deskripsi</label>
          <textarea 
            name="description" 
            rows="3" 
            placeholder="Jelaskan tujuan proyek/workspace ini..." 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"
          ></textarea>
        </div>

        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
          <button 
            type="button" 
            id="close-ws-modal"
            class="px-4 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition cursor-pointer"
          >
            Batal
          </button>
          <button 
            type="submit" 
            class="px-4 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-sm transition cursor-pointer"
          >
            Buat Workspace
          </button>
        </div>
      </form>
    </div>
  </div>
  <!-- Modal Invite Link Berhasil -->
  <div id="invite-success-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 text-center max-h-[92dvh] overflow-y-auto">
      <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-xl mb-3">
        🔗
      </div>
      <h3 class="text-base font-bold text-slate-800 mb-1">Undang Anggota Tim</h3>
      <p class="text-xs text-slate-400 mb-4" id="invite-modal-desc">Bagikan tautan ini ke rekan tim Anda. Tautan berlaku selama 7 hari.</p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl p-2 mb-4">
        <input 
          type="text" 
          id="invite-link-input" 
          readonly 
          class="w-full min-w-0 bg-transparent text-xs text-slate-700 focus:outline-none select-all px-1 py-1"
        />
        <button 
          id="copy-invite-btn"
          class="w-full sm:w-auto px-3 py-2 sm:py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg shrink-0 transition cursor-pointer"
        >
          Salin
        </button>
      </div>

      <button 
        type="button" 
        id="close-invite-modal"
        class="w-full py-2.5 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition cursor-pointer"
      >
        Tutup
      </button>
    </div>
  </div>


  <script>
    const openBtn = document.getElementById('open-ws-modal');
    const closeBtn = document.getElementById('close-ws-modal');
    const modal = document.getElementById('ws-modal');
    const form = document.getElementById('create-ws-form') as HTMLFormElement;

    openBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        description: formData.get('description'),
      };

      const res = await fetch('/api/workspaces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Gagal membuat workspace');
      }
    });
    // Handle Invite Team Link Generation
    const inviteBtns = document.querySelectorAll('.invite-team-btn');
    const inviteModal = document.getElementById('invite-success-modal');
    const closeInviteModal = document.getElementById('close-invite-modal');
    const inviteLinkInput = document.getElementById('invite-link-input') as HTMLInputElement;
    const copyInviteBtn = document.getElementById('copy-invite-btn');

    closeInviteModal?.addEventListener('click', () => inviteModal?.classList.add('hidden'));

    inviteBtns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const workspaceId = target.dataset.workspaceId;
        const prevText = target.innerHTML;
        target.innerHTML = '<span>⏳</span> Membuat tautan...';

        try {
          const res = await fetch(`/api/workspaces/${workspaceId}/invites`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role: 'member' }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Gagal membuat tautan');

          if (inviteLinkInput) {
            inviteLinkInput.value = data.inviteLink;
          }
          inviteModal?.classList.remove('hidden');
        } catch (err: any) {
          alert(err.message);
        } finally {
          target.innerHTML = prevText;
        }
      });
    });

    copyInviteBtn?.addEventListener('click', async () => {
      if (inviteLinkInput) {
        await navigator.clipboard.writeText(inviteLinkInput.value);
        copyInviteBtn.textContent = 'Tersalin! ✓';
        setTimeout(() => {
          copyInviteBtn.textContent = 'Salin';
        }, 2000);
      }
    });

  </script>
</DashboardLayout>
