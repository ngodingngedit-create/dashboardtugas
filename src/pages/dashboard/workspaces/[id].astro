---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { createAstroSupabaseClient } from '../../../lib/supabase';
import type { Workspace, WorkspaceMaterial } from '../../../types/database';

const supabase = createAstroSupabaseClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
if (!user) {
  return Astro.redirect('/login');
}

const workspaceId = Astro.params.id;

// Pastikan user adalah anggota workspace ini (isolasi per-login).
const { data: myMembership } = await supabase
  .from('workspace_members')
  .select('role')
  .eq('workspace_id', workspaceId)
  .eq('user_id', user.id)
  .single();

if (!myMembership) {
  return Astro.redirect('/dashboard/workspaces');
}
const myRole = (myMembership as any).role as string;
const isOwner = myRole === 'owner';

const { data: workspace } = await supabase
  .from('workspaces')
  .select('*')
  .eq('id', workspaceId)
  .single();

if (!workspace) {
  return Astro.redirect('/dashboard/workspaces');
}

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user.id)
  .single();

const { data: memberWorkspaces } = await supabase
  .from('workspace_members')
  .select('workspace:workspaces (*)')
  .eq('user_id', user.id);

const workspaces: Workspace[] = (memberWorkspaces || [])
  .map((m: any) => m.workspace)
  .filter(Boolean);

// Materi workspace ini (teks + link). Semua anggota boleh baca & tulis.
const { data: materialsData } = await supabase
  .from('workspace_materials')
  .select('*, author:profiles!workspace_materials_created_by_fkey (id, full_name, avatar_url)')
  .eq('workspace_id', workspaceId)
  .order('updated_at', { ascending: false });

const materials: WorkspaceMaterial[] = (materialsData as any[]) || [];
---

<DashboardLayout
  title={`${(workspace as any).name} - Materi - TaskPilot`}
  headerTitle={(workspace as any).name}
  user={user}
  profile={profile}
  workspaces={workspaces}
  currentWorkspace={workspace as Workspace}
>
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <a href="/dashboard/workspaces" class="text-xs font-semibold text-slate-500 hover:text-indigo-600 transition">
          &larr; Kembali ke Daftar Workspace
        </a>
        <h2 class="text-lg sm:text-xl font-bold text-slate-800 mt-1">Materi Workspace</h2>
        <p class="text-xs text-slate-400 mt-1">
          Catat materi atau tautan penting untuk {(workspace as any).name}. Terlihat oleh semua anggota workspace ini.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-md bg-indigo-50 text-indigo-600">
          {myRole}
        </span>
        <a
          href={`/dashboard?workspace_id=${workspaceId}`}
          class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl transition whitespace-nowrap"
        >
          Buka Board
        </a>
        <button
          id="open-material-modal"
          class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-sm transition cursor-pointer whitespace-nowrap"
        >
          + Tambah Materi
        </button>
      </div>
    </div>

    <div id="materials-list" class="space-y-3">
      {materials.map((m: any) => (
        <article
          class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs"
          data-material-id={m.id}
          data-material-title={m.title}
          data-material-content={m.content || ''}
          data-material-link={m.link_url || ''}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-sm sm:text-base text-slate-800 break-words leading-snug">{m.title}</h3>
              <p class="text-[11px] text-slate-400 mt-1">
                Ditulis oleh {m.author?.full_name || 'Anggota'} &bull; {new Date(m.updated_at).toLocaleString('id-ID')}
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button
                class="material-edit-btn text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition cursor-pointer"
                data-material-id={m.id}
              >
                Ubah
              </button>
              <button
                class="material-delete-btn text-xs font-semibold text-rose-500 hover:text-rose-700 transition cursor-pointer"
                data-material-id={m.id}
              >
                Hapus
              </button>
            </div>
          </div>
          {m.content && (
            <p class="text-xs text-slate-600 whitespace-pre-line leading-relaxed mt-3 break-words">{m.content}</p>
          )}
          {m.link_url && (
            <a
              href={m.link_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-3 text-xs font-semibold text-indigo-600 hover:text-indigo-800 break-all"
            >
              🔗 {m.link_url}
            </a>
          )}
        </article>
      ))}
      {materials.length === 0 && (
        <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 px-5 sm:px-8">
          <div class="text-4xl mb-4">📚</div>
          <h3 class="text-sm font-bold text-slate-700">Belum ada materi</h3>
          <p class="text-xs text-slate-400 mt-1">Tambahkan materi pertama agar mudah ditemukan anggota tim.</p>
        </div>
      )}
    </div>
  </div>

  <!-- Modal Tambah / Ubah Materi -->
  <div id="material-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 max-h-[92dvh] overflow-y-auto">
      <h3 id="material-modal-title" class="text-base font-bold text-slate-800 mb-4">Tambah Materi</h3>
      <form id="material-form" class="space-y-4">
        <input type="hidden" id="material-id" />
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Judul Materi</label>
          <input type="text" id="material-title" required placeholder="Contoh: Rangkuman Bab 1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Isi Materi (teks)</label>
          <textarea id="material-content" rows="6" placeholder="Tulis catatan atau rangkuman materi di sini..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Tautan (opsional)</label>
          <input type="url" id="material-link" placeholder="https://..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none" />
        </div>
        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
          <button type="button" id="close-material-modal" class="px-4 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition cursor-pointer">Batal</button>
          <button type="submit" class="px-4 py-2 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-sm transition cursor-pointer">Simpan Materi</button>
        </div>
      </form>
    </div>
  </div>

  {isOwner && (
    <div class="max-w-4xl mx-auto mt-8">
      <div class="bg-rose-50/60 border border-rose-100 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-between">
        <div>
          <h3 class="text-sm font-bold text-rose-700">Zona Berbahaya</h3>
          <p class="text-xs text-rose-500 mt-0.5">Menghapus workspace akan menghapus seluruh tugas, materi, dan anggota di dalamnya.</p>
        </div>
        <button id="delete-workspace-btn" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-xl transition cursor-pointer shrink-0">Hapus Workspace Ini</button>
      </div>
    </div>
  )}

  <script define:vars={{ workspaceId }}>
    const modal = document.getElementById('material-modal');
    const modalTitle = document.getElementById('material-modal-title');
    const form = document.getElementById('material-form');
    const idInput = document.getElementById('material-id');
    const titleInput = document.getElementById('material-title');
    const contentInput = document.getElementById('material-content');
    const linkInput = document.getElementById('material-link');
    const openModal = (mode, preset) => {
      if (modalTitle) modalTitle.textContent = mode === 'edit' ? 'Ubah Materi' : 'Tambah Materi';
      if (idInput) idInput.value = preset?.id || '';
      if (titleInput) titleInput.value = preset?.title || '';
      if (contentInput) contentInput.value = preset?.content || '';
      if (linkInput) linkInput.value = preset?.link || '';
      modal?.classList.remove('hidden');
    };
    document.getElementById('open-material-modal')?.addEventListener('click', () => openModal('create'));
    document.getElementById('close-material-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.querySelectorAll('.material-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('article');
        openModal('edit', {
          id: btn.dataset.materialId,
          title: card?.dataset.materialTitle || '',
          content: card?.dataset.materialContent || '',
          link: card?.dataset.materialLink || '',
        });
      });
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const mid = idInput?.value;
      const payload = { title: titleInput?.value, content: contentInput?.value, link_url: linkInput?.value };
      const url = mid ? `/api/materials/${mid}` : `/api/workspaces/${workspaceId}/materials`;
      const res = await fetch(url, { method: mid ? 'PATCH' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) { window.location.reload(); }
      else { const data = await res.json().catch(() => ({})); alert(data.error || 'Gagal menyimpan materi'); }
    });
    document.querySelectorAll('.material-delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Hapus materi ini?')) return;
        const res = await fetch(`/api/materials/${btn.dataset.materialId}`, { method: 'DELETE' });
        if (res.ok) window.location.reload(); else alert('Gagal menghapus materi');
      });
    });
    document.getElementById('delete-workspace-btn')?.addEventListener('click', async () => {
      if (!confirm('Hapus workspace ini beserta seluruh tugas dan materinya? Tindakan ini tidak bisa dibatalkan.')) return;
      const res = await fetch(`/api/workspaces/${workspaceId}`, { method: 'DELETE' });
      if (res.ok) { window.location.href = '/dashboard/workspaces'; }
      else { const data = await res.json().catch(() => ({})); alert(data.error || 'Gagal menghapus workspace'); }
    });
  </script>

</DashboardLayout>
