---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createAstroSupabaseClient } from '../../lib/supabase';
import { dueInfo } from '../../lib/due-date';
import type { Workspace } from '../../types/database';

const supabase = createAstroSupabaseClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user?.id)
  .single();

// Guard: hanya superadmin global yang boleh mengakses halaman ini
if (!profile?.is_admin) {
  return Astro.redirect('/dashboard');
}

const { data: memberWorkspaces } = await supabase
  .from('workspace_members')
  .select('workspace:workspaces (*)')
  .eq('user_id', user?.id);
const workspaces: Workspace[] = (memberWorkspaces || [])
  .map((m: any) => m.workspace)
  .filter(Boolean);

// Superadmin: ambil SEMUA workspace beserta member dan tugasnya
const { data: allWorkspaces } = await supabase
  .from('workspaces')
  .select(`
    *,
    members:workspace_members (
      id,
      role,
      profile:profiles (id, full_name, avatar_url)
    ),
    tasks (
      id,
      title,
      status,
      due_date,
      created_at
    )
  `)
  .order('created_at', { ascending: false });

const today = new Date();
today.setHours(0, 0, 0, 0);

const statusLabels: Record<string, string> = {
  backlog: 'Backlog',
  todo: 'To Do',
  in_progress: 'In Progress',
  review: 'Review',
  done: 'Done',
  archived: 'Archived',
};

const monitored = (allWorkspaces || []).map((ws: any) => {
  const tasks: any[] = ws.tasks || [];
  const members: any[] = ws.members || [];
  const total = tasks.length;
  const done = tasks.filter((t) => t.status === 'done').length;
  const overdue = tasks.filter((t) => {
    if (!t.due_date || t.status === 'done' || t.status === 'archived') return false;
    const due = new Date(t.due_date);
    due.setHours(0, 0, 0, 0);
    return due.getTime() < today.getTime();
  });
  const perStatus = Object.keys(statusLabels).map((s) => ({
    status: s,
    count: tasks.filter((t) => t.status === s).length,
  }));
  const recentOverdue = overdue
    .sort((a, b) => new Date(a.due_date).getTime() - new Date(b.due_date).getTime())
    .slice(0, 3);
  const progress = total > 0 ? Math.round((done / total) * 100) : 0;
  const owner = members.find((m) => m.role === 'owner');
  return { ...ws, tasks, members, total, done, overdueCount: overdue.length, perStatus, recentOverdue, progress, owner };
});

const totalTasks = monitored.reduce((acc: number, ws: any) => acc + ws.total, 0);
const totalDone = monitored.reduce((acc: number, ws: any) => acc + ws.done, 0);
const totalOverdue = monitored.reduce((acc: number, ws: any) => acc + ws.overdueCount, 0);
---

<DashboardLayout
  title="Admin Monitor - TaskPilot"
  headerTitle="Admin Monitor — Semua Workspace"
  user={user}
  profile={profile}
  workspaces={workspaces}
  currentWorkspace={null}
>
  <div class="max-w-6xl mx-auto space-y-5 sm:space-y-6">
    <div>
      <h2 class="text-lg sm:text-xl font-bold text-slate-800">Pemantauan Semua Workspace</h2>
      <p class="text-xs text-slate-400 mt-1">Ringkasan progress seluruh workspace di aplikasi. Halaman ini hanya bisa diakses superadmin.</p>
    </div>

    <!-- Ringkasan global -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Workspace</p>
        <p class="text-2xl font-bold text-slate-800 mt-1">{monitored.length}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Tugas</p>
        <p class="text-2xl font-bold text-slate-800 mt-1">{totalTasks}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Selesai</p>
        <p class="text-2xl font-bold text-emerald-600 mt-1">{totalDone}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Terlambat</p>
        <p class="text-2xl font-bold text-rose-600 mt-1">{totalOverdue}</p>
      </div>
    </div>

    {monitored.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 px-5 sm:px-8">
        <div class="text-4xl mb-4">🗂️</div>
        <h3 class="text-sm font-bold text-slate-700">Belum ada workspace</h3>
        <p class="text-xs text-slate-400 mt-1">Belum ada workspace yang terdaftar di aplikasi.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {monitored.map((ws: any) => (
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-bold text-slate-800 truncate">{ws.name}</h3>
                <p class="text-[11px] text-slate-400 truncate mt-0.5">
                  Owner: {ws.owner?.profile?.full_name || '—'} • {ws.members.length} member • dibuat {new Date(ws.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </p>
              </div>
              {ws.overdueCount > 0 && (
                <span class="shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-lg bg-rose-50 text-rose-600">
                  {ws.overdueCount} terlambat
                </span>
              )}
            </div>

            <!-- Progress bar -->
            <div>
              <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 mb-1.5">
                <span>Progress</span>
                <span>{ws.done}/{ws.total} tugas selesai ({ws.progress}%)</span>
              </div>
              <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class={`h-full rounded-full transition-all ${ws.progress === 100 ? 'bg-emerald-500' : 'bg-indigo-500'}`} style={`width: ${ws.progress}%`}></div>
              </div>
            </div>

            <!-- Breakdown status -->
            <div class="flex flex-wrap gap-1.5">
              {ws.perStatus.filter((s: any) => s.count > 0).map((s: any) => (
                <span class={`text-[10px] font-bold px-2 py-1 rounded-lg ${s.status === 'done' ? 'bg-emerald-50 text-emerald-600' : s.status === 'in_progress' ? 'bg-blue-50 text-blue-600' : s.status === 'review' ? 'bg-violet-50 text-violet-600' : 'bg-slate-100 text-slate-600'}`}>
                  {statusLabels[s.status]}: {s.count}
                </span>
              ))}
              {ws.total === 0 && <span class="text-[11px] text-slate-400">Belum ada tugas</span>}
            </div>

            <!-- Tugas terlambat -->
            {ws.recentOverdue.length > 0 && (
              <div class="border-t border-slate-100 pt-3 space-y-1.5">
                <p class="text-[10px] font-bold text-rose-500 uppercase tracking-wider">Deadline terlewat</p>
                {ws.recentOverdue.map((t: any) => {
                  const due = dueInfo(t.due_date, t.status);
                  return (
                    <a href={`/dashboard/task/${t.id}`} class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 hover:bg-slate-50 transition">
                      <span class="text-xs font-medium text-slate-700 truncate">{t.title}</span>
                      <span class={`shrink-0 text-[9px] font-bold px-1.5 py-0.5 rounded ${due.tone}`}>{due.label}</span>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</DashboardLayout>
