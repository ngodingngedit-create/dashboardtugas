---
import BaseLayout from './BaseLayout.astro';
import type { Profile, Workspace } from '../types/database';

interface Props {
  title?: string;
  user: any;
  profile: Profile | null;
  workspaces: Workspace[];
  currentWorkspace?: Workspace | null;
}

const { title = 'Dashboard', user, profile, workspaces, currentWorkspace } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="flex h-screen h-dvh overflow-hidden bg-slate-50">
    <!-- Mobile sidebar overlay -->
    <div id="sidebar-overlay" class="hidden fixed inset-0 z-30 bg-slate-900/50 backdrop-blur-[1px] lg:hidden"></div>

    <!-- Sidebar / Drawer -->
    <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 z-40 flex w-72 max-w-[85vw] -translate-x-full flex-col justify-between bg-white border-r border-slate-200 shadow-2xl transition-transform duration-300 ease-in-out lg:static lg:z-auto lg:w-64 lg:max-w-none lg:shrink-0 lg:translate-x-0 lg:shadow-none">
      <div>
        <!-- App Header / Logo -->
        <div class="h-16 flex items-center gap-3 px-5 sm:px-6 border-b border-slate-200">
          <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm shrink-0">
            DT
          </div>
          <span class="font-bold text-slate-800 text-lg tracking-tight truncate">TaskPilot</span>
          <button
            id="sidebar-close-btn"
            type="button"
            aria-label="Tutup menu"
            class="ml-auto flex h-9 w-9 items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition lg:hidden"
          >
            ✕
          </button>
        </div>

        <!-- Workspace Selector -->
        <div class="p-4 border-b border-slate-100">
          <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Workspace</label>
          <select 
            id="workspace-switcher" 
            class="w-full text-sm font-medium bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-700 cursor-pointer focus:outline-none"
          >
            {workspaces.map((ws) => (
              <option value={ws.id} selected={currentWorkspace?.id === ws.id}>
                {ws.name}
              </option>
            ))}
            {workspaces.length === 0 && (
              <option value="">Belum ada workspace</option>
            )}
          </select>
        </div>

        <!-- Navigation Menu -->
        <nav class="p-4 space-y-1">
          <a 
            href="/dashboard" 
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition ${pathname === '/dashboard' ? 'bg-indigo-50 text-indigo-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'}`}
          >
            <span class="text-base">📋</span> Board Tugas
          </a>

          <a 
            href="/dashboard/my-tasks" 
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition ${pathname === '/dashboard/my-tasks' ? 'bg-indigo-50 text-indigo-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'}`}
          >
            <span class="text-base">✅</span> Tugas Saya
          </a>

          <a 
            href="/dashboard/workspaces" 
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition ${pathname.startsWith('/dashboard/workspaces') ? 'bg-indigo-50 text-indigo-600 font-semibold' : 'text-slate-600 hover:bg-slate-50'}`}
          >
            <span class="text-base">📁</span> Kelola Workspace
          </a>
        </nav>
      </div>

      <!-- User Profile & Sign Out -->
      <div class="p-4 border-t border-slate-200">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-600 text-xs shrink-0">
              {profile?.full_name?.charAt(0).toUpperCase() || 'U'}
            </div>
            <div class="truncate">
              <p class="text-xs font-bold text-slate-800 truncate">{profile?.full_name || 'User'}</p>
              <p class="text-[10px] text-slate-400 truncate">{user?.email}</p>
            </div>
          </div>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" title="Keluar" class="text-xs text-rose-500 hover:text-rose-700 font-medium">
              Logout
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-screen h-dvh min-w-0 overflow-hidden">
      <header class="min-h-16 bg-white border-b border-slate-200 px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between gap-3 shrink-0">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0 flex-1">
          <button
            id="sidebar-open-btn"
            type="button"
            aria-label="Buka menu navigasi"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-lg text-slate-600 shadow-xs transition hover:bg-slate-50 active:scale-95 lg:hidden"
          >
            ☰
          </button>
          <div class="min-w-0 flex-1">
            <h1 class="text-base sm:text-lg font-bold text-slate-800 truncate">{currentWorkspace?.name || 'Dashboard'}</h1>
            {currentWorkspace?.description && (
              <p class="hidden text-xs text-slate-400 truncate max-w-md sm:block">{currentWorkspace.description}</p>
            )}
          </div>
        </div>
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <slot name="header-actions" />
        </div>
      </header>

      <main class="flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 lg:p-8 bg-slate-50">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const switcher = document.getElementById('workspace-switcher') as HTMLSelectElement;
    if (switcher) {
      switcher.addEventListener('change', (e) => {
        const wsId = (e.target as HTMLSelectElement).value;
        if (wsId) {
          window.location.href = `/dashboard?workspace_id=${wsId}`;
        }
      });
    }

    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const openBtn = document.getElementById('sidebar-open-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');

    const openSidebar = () => {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
    };

    const closeSidebar = () => {
      if (window.innerWidth >= 1024) return;
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
    };

    openBtn?.addEventListener('click', openSidebar);
    closeBtn?.addEventListener('click', closeSidebar);
    overlay?.addEventListener('click', closeSidebar);
    sidebar?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeSidebar);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        overlay?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
      }
    });
  </script>
</BaseLayout>
